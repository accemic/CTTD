# Build log generated by 'make tst >makelog.txt' (contains local paths — keep out of git).
/examples/all/makelog.txt

# Example build artifacts (see examples/all 'make clean'): per-test objdump,
# extracted spike traces, and decode reports — all regenerated by 'make tst'.
# The all*.txt aggregate baselines are tracked and intentionally NOT ignored.
*-objd.txt
*-report.txt
*.spike_pc_trace_filtered

